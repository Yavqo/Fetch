{
  "name": "@yavqo/fetch",
  "version": "0.1.0",
  "description": "Native fetch, but cleaner. A tiny, typed HTTP client from Yavqo Labs.",
  "keywords": [
    "fetch",
    "http",
    "http-client",
    "request",
    "typescript",
    "retry",
    "timeout",
    "interceptors"
  ],
  "homepage": "https://github.com/Yavqo/Fetch#readme",
  "bugs": "https://github.com/Yavqo/Fetch/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yavqo/Fetch.git"
  },
  "license": "MIT",
  "author": "Yavqo Labs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run size",
    "size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
