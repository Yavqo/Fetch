{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@yavqo/fetch": ["./src/index.ts"], "@yavqo/fetch/testing": ["./src/testing.ts"] }
  },
  "include": ["src", "test", "examples", "tsup.config.ts", "vitest.config.ts"]
}
